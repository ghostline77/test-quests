    "contacts": {
      "regina": {
        "id": "regina_jones", "localization_key": "LocKey#10891",
        "threads": {
          "offer": {
            "id": "gqt009_offer", "title": "Cyberpsycho Sighting: Heavy Metal", "title_key": "gl_gqt009_offer_title",
            "entries": {
              "brief": {"type": "message", "id": "00_brief", "text": "Got a cyberpsycho report from Kabuki. Darius Voss, former heavy-lift security. Big frame, military mantis blades. First responders pulled back after he cut through their cover. Sending coordinates. Try to keep him alive.", "localization_key": "gl_gqt009_brief", "important": true, "attachment": "@quest.path"},
              "response": {"type": "choice_group", "id": "01_response", "entries": {"accept": {"id": "01a_accept", "text": "On my way.", "localization_key": "gl_gqt009_accept"}}}
            }
          },
          "report": {
            "id": "gqt009_report", "title": "Heavy Metal: follow-up", "title_key": "gl_gqt009_report_title",
            "entries": {
              "status": {"type": "message", "id": "00_status", "text": "The site's gone quiet. What's Voss's condition?", "localization_key": "gl_gqt009_status"},
              "killed": {"type": "message", "id": "01a_killed", "text": "He's dead. Recovered his service log. Someone kept rejecting his implant repairs.", "localization_key": "gl_gqt009_killed", "sender": "Player"},
              "spared": {"type": "message", "id": "01b_spared", "text": "Alive and contained. Recovered his service log. Someone kept rejecting his implant repairs.", "localization_key": "gl_gqt009_spared", "sender": "Player"},
              "response": {"type": "choice_group", "id": "02_response", "entries": {
                "send_log": {"id": "02a_send_log", "text": "Sending you the log.", "localization_key": "gl_gqt009_send_log"},
                "ask_repairs": {"id": "02b_ask_repairs", "text": "Who signed off on those implants?", "localization_key": "gl_gqt009_ask_repairs"}
              }},
              "received": {"type": "message", "id": "03_received", "text": "Got it. The repair history gives my people somewhere to start. They'll secure the scene.", "localization_key": "gl_gqt009_received"},
              "trace": {"type": "message", "id": "03b_trace", "text": "The log carries a shell-company stamp. Send it over. I'll follow the paperwork while my team secures the scene.", "localization_key": "gl_gqt009_trace"},
              "complete": {"type": "message", "id": "04_complete", "text": "Your payment's on its way. Thanks, V.", "localization_key": "gl_gqt009_complete"}
            }
          }
        }
      }
    },
    "readables": {
      "service_log": {"kind": "onscreen", "group": "shards", "id": "service_log", "title": "VOSS // SERVICE DENIED", "title_key": "gl_gqt009_log_title", "text": "SERVICE REQUEST 119: Forearm mounting plates separating under load. Pain inhibitors no longer suppressing feedback.\nRESPONSE: Replacement components outside approved body specification. Claim denied.\n\nSERVICE REQUEST 126: Blades deploying without command. Cannot work. Cannot sleep.\nRESPONSE: User modification detected. Warranty void.\n\nLOCAL NOTE: Told them the brackets didn't fit. Told them what the screaming felt like. They told me to clock in.", "text_key": "gl_gqt009_log_body"}
    },
